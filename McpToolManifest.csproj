<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>McpToolManifest</RootNamespace>
    <AssemblyName>McpToolManifest</AssemblyName>
    <PackageId>AIGuiders.McpToolManifest</PackageId>
    <Version>1.0.0</Version>
    <Authors>Dmitry Karataev; AIGuiders</Authors>
    <Company>AIGuiders</Company>
    <Description>Per-MCP tool manifest format (mcp-tools.manifest.json): load, validate, compare names with runtime catalog.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KarataevDmitry/mcp-tool-manifest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KarataevDmitry/mcp-tool-manifest.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;modelcontextprotocol;manifest;tools</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="McpToolManifest.Tests\**\*.cs" />
    <None Remove="McpToolManifest.Tests\**\*" />
  </ItemGroup>

</Project>
